<?xml version="1.0" encoding="utf-8"?>
<!--
  Sauvegarde et transfert d'appareil désactivés (Android 12+).
  Les identifiants IPTV sont chiffrés par une clé du Keystore, qui ne quitte jamais l'appareil :
  une restauration sur un autre téléphone ne pourrait pas les déchiffrer, et copier des données
  de session ailleurs n'apporte rien à l'utilisateur.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
